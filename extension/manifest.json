{
  "manifest_version": 3,
  "name": "Image Batch Downloader",
  "description": "Download images in bulk from a spreadsheet of titles and URLs, straight to a ZIP — no CORS proxy needed.",
  "version": "1.4.1",
  "key": "",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "Image Batch Downloader",
    "default_popup": "popup.html"
  },
  "permissions": ["downloads", "tabs", "scripting"],
  "host_permissions": ["http://*/*", "https://*/*"]
}
